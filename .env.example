# Environment Variables for NSS Recruitment Online Test Portal
# Copy this file to server/.env

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nss_recruitment?retryWrites=true&w=majority
# Or local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/nss_recruitment
JWT_SECRET=nss_recruitment_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

